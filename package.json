{
  "name": "snaplorebooth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4300",
    "build": "next build",
    "start": "next start -p 4300",
    "lint": "next lint",
    "dev:https": "next dev -p 4300 --experimental-https --experimental-https-key ./certs/booth-key.pem --experimental-https-cert ./certs/booth.pem",
    "certs": "mkcert -cert-file certs/booth.pem -key-file certs/booth-key.pem localhost 127.0.0.1 ::1 $(ipconfig getifaddr en0)",
    "camera:free": "bash scripts/free-camera.sh",
    "tunnel": "cloudflared tunnel --url http://localhost:4300",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^12.11.1",
    "next": "^15.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
